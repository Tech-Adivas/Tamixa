# Backend API base URL (no trailing slash).
# The admin app calls /api/* on the Next server; those routes proxy to this URL (server-side).
# If you see "Backend unreachable", the proxy cannot open a TCP connection here (wrong host/port or API down).
# Local: http://127.0.0.1:8080 (preferred for stable loopback); localhost can resolve to IPv6-only on some machines
# Docker admin → host API: http://host.docker.internal:8080
# Production: https://api.tamixa.com
# Railway: set BOTH to your *backend* service public URL (e.g. https://tamixa-prod.up.railway.app),
# NOT the admin URL and NOT the parent web URL. Redeploy after changing NEXT_PUBLIC_* (build-time).
# Wrong or stale URLs often produce Railway's "Application not found" on login.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# Optional override for the proxy only (otherwise NEXT_PUBLIC_API_URL is used):
# API_URL=http://127.0.0.1:8080
# IMPORTANT: if both are set, keep API_URL and NEXT_PUBLIC_API_URL identical.
# Mismatched values can make SSR/proxy requests hit different backends and show inconsistent story counts.

# Use mock data for dashboard KPIs, charts, etc. Set to false for production.
# NEXT_PUBLIC_USE_MOCK_API=true
# Production: NEXT_PUBLIC_USE_MOCK_API=false

# Optional: enable verbose logging
# NEXT_PUBLIC_DEBUG=false
