# Backend API base URL (no trailing slash). REQUIRED – Next.js proxy does NOT forward
# Authorization header; unauthenticated requests (Submit for review, etc.) will fail with 401.
# Local: http://localhost:8080
# Production: https://api.tamixa.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Use mock data for dashboard KPIs, charts, etc. Set to false for production.
# NEXT_PUBLIC_USE_MOCK_API=true
# Production: NEXT_PUBLIC_USE_MOCK_API=false

# Optional: enable verbose logging
# NEXT_PUBLIC_DEBUG=false
