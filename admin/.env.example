# Backend API base URL (no trailing slash). Leave UNSET for local dev to use Next.js proxy.
# Local (proxy): leave unset – requests go to /api/*, proxied to http://localhost:8080
# Local (direct): http://localhost:8080
# Production: https://api.araro.com
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Use mock data for dashboard KPIs, charts, etc. Set to false for production.
# NEXT_PUBLIC_USE_MOCK_API=true
# Production: NEXT_PUBLIC_USE_MOCK_API=false

# Optional: enable verbose logging
# NEXT_PUBLIC_DEBUG=false
