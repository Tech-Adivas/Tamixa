# Template: Railway-style Postgres variables for the backend (copy to `railway.env` and fill with values
# from Railway → Postgres → Variables / Connect). Safe to commit — no real secrets.
#
# Connectivity: `./scripts/check-db-connection.sh` uses DATABASE_PUBLIC_URL first (works from your laptop).
# On Railway, the JVM sets RAILWAY_* env; the app then prefers DATABASE_URL (private) when both URLs exist,
# so the running service uses postgres.railway.internal — same database, no functional change vs public proxy.
#
# Do NOT set PGDATA here for the app. PGDATA is a data-directory path on the Postgres service only,
# not a connection URL.

DATABASE_PUBLIC_URL=postgresql://USER:PASSWORD@HOST.tcp.proxy.rlwy.net:PORT/railway
DATABASE_URL=postgresql://USER:PASSWORD@postgres.railway.internal:5432/railway

PGDATABASE=railway
PGHOST=postgres.railway.internal
PGPASSWORD=your-postgres-password
PGPORT=5432
PGUSER=postgres

POSTGRES_DB=railway
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_USER=postgres

# SPRING_PROFILES_ACTIVE=staging
