# Tamixa shared configuration (see config/README.md)
# Copy to .env and override as needed for your environment.
#
# SECURITY: .env is in .gitignore — never commit .env. Use this file as a template only (no real keys here).
# In production, inject secrets via a secrets manager or CI/CD, not from a .env file in the repo.

# API Backend (default: localhost)
API_BASE_URL=http://localhost:8080

# Audio stream URLs returned to mobile. Emulator: http://10.0.2.2:8080 (Android) or http://localhost:8080 (iOS sim). Physical device: your machine's LAN IP, e.g. http://192.168.1.5:8080
# AUDIO_PUBLIC_BASE_URL=http://localhost:8080
# Optional MP4 for stream-url hostStoryClipUrl (full https URL or path joined with public base). Muted in the app.
# AUDIO_HOST_STORY_CLIP_URL=

# Admin (Next.js) - use NEXT_PUBLIC_API_URL in admin/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8080
# If admin/.env.local also sets API_URL, keep both values identical to avoid split backend reads.

# Backend magic links - web app URL for email links
# MAGIC_LINK_BASE_URL=http://localhost:3000

# SendGrid (magic link emails). Set SENDGRID_API_KEY for real emails.
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Dummy OTP for testing (no real SMS). Use this code with any phone.
# DEV_OTP_CODE=123456
# Web passwordless dev bypass (any email + this code). Dev only.
# DEV_PASSWORDLESS_CODE=123456
# Production: leave DEV_OTP_CODE and DEV_PASSWORDLESS_CODE unset. With profile prod, the API fails fast if either is set (see ProductionDevBypassValidator).

# Dev: enable POST /api/v1/dev/seed-admin to create/reset admin@techadivas.com / Admin123!
# Never set in production. Use only with dev profile.
# SEED_ADMIN_ENABLED=true

# --- Backend DB (dev/staging/prod precedence) ---
# Railway: use Variable Reference on the **backend** service to Postgres (`DATABASE_URL`, `DATABASE_PUBLIC_URL`,
# `PGPASSWORD`, etc.). For a local file mirroring those names, see `railway.env.example` → copy to `railway.env`
# (gitignored as `*.env`). Test connectivity: `./scripts/check-db-connection.sh railway.env`
# Prefer DATABASE_URL / DATABASE_USERNAME / DATABASE_PASSWORD for consistency with Flyway and deployment jobs.
# POSTGRES_* remains supported as fallback for local convenience.
# If both are set, ensure they point to the same database instance.
# DATABASE_URL=jdbc:postgresql://localhost:5432/araro_kids
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=araro_kids
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# --- Rate limiting ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_USE_REDIS=false   # Set true for multi-instance: uses Redis. Requires Redis.
# RATE_LIMIT_REQUESTS_PER_MINUTE=100   # General API per client IP
# RATE_LIMIT_ADMIN_REQUESTS_PER_MINUTE=200   # Admin API per client IP (no full bypass)
# RATE_LIMIT_SESSION_REQUESTS_PER_MINUTE=300   # /auth/me + /auth/refresh (avoid starving token refresh)

# --- Bulk job store (multi-instance) ---
# BULK_JOB_USE_REDIS=false   # Set true for multi-instance: uses Redis for bulk job state. Requires Redis.

# --- Push notifications (FCM for Android, APNs for iOS) ---
# FCM_SERVER_KEY=   # Firebase Cloud Messaging server key from Firebase Console > Project Settings > Cloud Messaging
# APNS_ENABLED=false   # Set true when using APNs (key id, team id, and .p8 path below). Off by default for local dev.
# APNS_KEY_ID=      # Apple Push Notification service key ID from Apple Developer
# APNS_TEAM_ID=     # Apple Developer Team ID
# APNS_KEY_PATH=    # Path to .p8 key file (e.g. /path/to/AuthKey_KEYID.p8)
# APNS_BUNDLE_ID=com.tamixa.app   # iOS app bundle identifier
# APNS_PRODUCTION=false   # Set true for production APNs environment

# --- Production: CORS and webhook encryption ---
# CORS_ALLOWED_ORIGINS=https://app.tamixa.com,https://admin.tamixa.com   # Required in prod; no *
# SUBSCRIPTION_WEBHOOK_ENCRYPTION_KEY=   # 32-byte Base64 AES key. Required in prod when Stripe webhooks enabled (PCI).

# --- S3 audio storage (default) ---
# STORAGE_TYPE=s3
# S3_BUCKET=tamixa-audio
# Or use S3 Access Point ARN: arn:aws:s3:us-east-1:ACCOUNT:accesspoint/access-point-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=   # From terraform output
# AWS_SECRET_ACCESS_KEY=   # From terraform output (sensitive)

# --- Production: real translation (default: simulated) ---
# TRANSLATION_PROVIDER=openai

# --- Story length (library translation + narration rewrite use this cap in prompts and server-side clamp) ---
# STORY_MAX_WORDS=900
# When true, parent-generated stories stay PENDING_REVIEW until admin approves in Story moderation; then TTS/cover runs.
# STORY_HUMAN_REVIEW_BEFORE_NARRATION=true

# --- OpenAI: required for pipeline rewrite (REWRITING step) and translation ---
# OPENAI_API_KEY=sk-...   # Required. Pipeline rewrite uses OpenAI Chat Completions. Without it: "OpenAI API key not configured".
# When true, missing API key causes content moderation to reject all moderated content (child safety). Default false (dev); production profile defaults true.
# OPENAI_MODERATION_REQUIRED=true
# OPENAI_READ_TIMEOUT_MS=180000   # HTTP read timeout (default 3 min). Regenerate with prompt needs longer for full-story JSON. Set 60000 to fail faster.
# OPENAI_BASE_URL=https://api.openai.com   # Or proxy/custom endpoint

# --- Optional: reusable guardrails HTTP service (Python submodule `guardrails-service/`) ---
# Docker Compose: `guardrails-service` is built, backend waits for its healthcheck, and GUARDRAILS_SERVICE_ENABLED defaults to true.
# Run backend from IDE without Compose: set GUARDRAILS_SERVICE_ENABLED=false OR start guardrails on 8090 and set URL below.
# GUARDRAILS_SERVICE_ENABLED=false
# GUARDRAILS_SERVICE_URL=http://localhost:8090   # Compose sets http://guardrails-service:8090 for the backend container
# GUARDRAILS_SERVICE_API_KEY=   # Set the same value on guardrails container (GUARDRAILS_API_KEY) to require X-Guardrails-Api-Key
# GUARDRAILS_SERVICE_FAIL_OPEN=true   # If true, backend skips remote guardrails when unreachable (default false; prod often true for resilience)

# --- Narration: TTS (default: google). For Tamixa voice use tamixa + NARRATION_TAMIXA_TTS_DEFAULT_FILE ---
# One-switch style preset:
# - bedtime   -> bedtime-calm + soft
# - balanced  -> default + balanced
# - energetic -> kid-energy + high
# When this is set, it overrides manual style/intensity pairing.
# NARRATION_PRESET=
#
# Manual style preset (used when NARRATION_PRESET is empty):
# - default (neutral)
# - kid-energy (lively, faster, shorter pauses)
# - bedtime-calm (softer, slower, longer pauses)
# NARRATION_STYLE_PROFILE=default
# Voice modulation intensity for emotion prosody (+small Google speaking-rate shaping):
# - soft (subtle)
# - balanced (default)
# - high (more expressive)
# NARRATION_MODULATION_INTENSITY=balanced
# Regenerate flow minimum length target (admin regenerate-with-prompt).
# If output is shorter than this, a second expansion pass runs for richer narration.
# NARRATION_REGENERATE_MIN_WORDS=900
# Quick preset matrix:
# 1) Bedtime soothing:
#    NARRATION_STYLE_PROFILE=bedtime-calm
#    NARRATION_MODULATION_INTENSITY=soft
# 2) Everyday balanced storytelling:
#    NARRATION_STYLE_PROFILE=default
#    NARRATION_MODULATION_INTENSITY=balanced
# 3) Energetic daytime / activity stories:
#    NARRATION_STYLE_PROFILE=kid-energy
#    NARRATION_MODULATION_INTENSITY=high
# NARRATION_TTS_PROVIDER=tamixa   # DEFAULT. Sample only: same pre-recorded audio for every story (no story narration). For real narration use google.
# NARRATION_TTS_PROVIDER=google   # Story-specific narration – audio speaks the actual story. Set GOOGLE_CLOUD_TTS_API_KEY.
# NARRATION_TTS_PROVIDER=openai   # OpenAI voices – may sound non-native for Tamil/Hindi
# NARRATION_TTS_PROVIDER=sample   # Same as tamixa: local MP3s per language (ta.mp3, en.mp3…) or one file via NARRATION_TAMIXA_TTS_DEFAULT_FILE.
# NARRATION_TAMIXA_TTS_DEFAULT_FILE=classpath:tts-samples/tamixa.mp3   # For Tamixa voice: one MP3 for all languages. Put tamixa.mp3 in backend/src/main/resources/tts-samples/
# Needs OPENAI_API_KEY when openai. Needs GOOGLE_CLOUD_TTS_API_KEY when google. Tamixa/sample need no cloud keys.
# NARRATION_REWRITE_MODEL=gpt-4o  # gpt-4o = better conversational; gpt-4o-mini = cheaper but may sound dry
# NARRATION_REWRITE_TEMPERATURE=0.6   # Higher = more conversational (0.4–0.7). Dry reading = try 0.65
# NARRATION_OPENAI_TTS_SPEED=1.0     # 1.0 = normal pace. Use 0.95 for slower bedtime feel.
# GOOGLE_CLOUD_TTS_API_KEY=          # For NARRATION_TTS_PROVIDER=google. Enable Cloud Text-to-Speech API in GCP.
# NARRATION_GOOGLE_TTS_SPEED=0.95    # Slightly slower default for child-friendly 7–8 min pacing (range 0.25–2.0).
# NARRATION_GOOGLE_TTS_VOICE_NAME=Achernar   # Chirp 3 HD voice: Achernar (default), Leda, Kore, Pulcherrima (female); Charon, Orus, Rasalgethi (male). See https://cloud.google.com/text-to-speech/docs/chirp3-hd
# Optional explicit map per language for "very real" voices, format: lang=voice,lang=voice
# Example: NARRATION_GOOGLE_TTS_VOICE_OVERRIDES=ta-IN=ta-IN-Wavenet-A,te-IN=te-IN-Chirp3-HD-Kore,ml-IN=ml-IN-Wavenet-A,en-IN=en-IN-Chirp3-HD-Leda
# NARRATION_GOOGLE_TTS_VOICE_OVERRIDES=
# Recommended baseline for Tamixa multilingual storytelling:
# NARRATION_GOOGLE_TTS_VOICE_OVERRIDES=ta-IN=ta-IN-Wavenet-A,te-IN=te-IN-Standard-A,ml-IN=ml-IN-Wavenet-A,hi-IN=hi-IN-Wavenet-A,kn-IN=kn-IN-Wavenet-A,en-IN=en-IN-Chirp3-HD-Leda
# NARRATION_GOOGLE_TTS_AUDIO_ENCODING=MP3   # Default MP3 = valid playable files. LINEAR16 uploaded as .mp3 causes playback truncation.
# NARRATION_GOOGLE_TTS_SAMPLE_RATE=44100       # Sample rate in Hz (for LINEAR16). Output MP3 is 44100 Hz.
# NARRATION_GOOGLE_TTS_VOLUME_GAIN_DB=0        # Volume gain in dB (range -96 to 16). 0 = normal.
# NARRATION_SSML_USE_NATURAL_PACE=true         # true = rate 100%, no emotion prosody (matches Cloud samples). false = slower kid-friendly pacing.

# --- Avatar video (Replicate SadTalker default; optional D-ID, HeyGen, Gooey) ---
# AVATAR_VIDEO_ENABLED=false       # Set true to enable talking-head avatar video
# AVATAR_VIDEO_PROVIDER=sadtalker  # sadtalker (default) | heygen | d-id | gooey
# REPLICATE_API_TOKEN=             # Required when provider=sadtalker. https://replicate.com/account/api-tokens
# HEYGEN_API_KEY=                  # For provider=heygen (avatar video) and HeyGen cloned-voice TTS (set heygen_voice_id on profile via admin PATCH). https://app.heygen.com/
# DID_API_KEY=                     # Required when provider=d-id. D-ID Talks API (V2 photo avatar + custom audio). https://docs.d-id.com/ – try with ~2 min story.
# GOOEY_API_KEY=                   # Required when provider=gooey. https://gooey.ai/api/ – get API key
# GOOEY_RECIPE_ID=                 # Required when provider=gooey. Use the example_id from the recipe's API page. See docs/AVATAR_VIDEO.md.
# AVATAR_VIDEO_POLL_INTERVAL=20    # Seconds between status polls (Replicate/D-ID/Gooey)
# AVATAR_VIDEO_MAX_POLL=30         # Max poll attempts (~10 min total)

# --- Voice cloning (Google Chirp 3 primary | ElevenLabs fallback) ---
# VOICE_CLONING_ENABLED=false   # Set true to enable voice cloning from uploaded samples
# VOICE_CLONING_PROVIDER=google  # Primary provider: google (recommended) | elevenlabs | xtts
# VOICE_CLONING_ALLOW_ELEVENLABS_FALLBACK=true  # When primary=google, auto-fallback to ElevenLabs if Google fails.
# ELEVENLABS_API_KEY=           # Needed for fallback or when provider=elevenlabs. From https://elevenlabs.io/
# GOOGLE_CLOUD_TTS_API_KEY=     # Required when provider=google. Same key as narration TTS.
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io   # Or regional endpoint
# XTTS_BASE_URL=http://localhost:9000  # Self-hosted XTTS when provider=xtts
# XTTS_TIMEOUT_SECONDS=1800  # Read timeout for /synthesize (default 30 min). Full-story cloned synthesis can take 5–30+ min.

# --- Share clip (Premium+), Instagram/YouTube ---
# SHARE_CLIP_ENABLED=true
# SHARE_CLIP_CLIPS_PER_MONTH=10       # Premium+ quota per month
# SHARE_BASE_URL=https://tamixa.com   # Deep link base (e.g. https://tamixa.com/s/123)
# SHARE_CLIP_FFMPEG_ENABLED=false     # Set true when ffmpeg is installed for clip rendering (cover+audio+watermark)

# --- Pipeline parallelism & when to run ---
# TRANSLATION_PIPELINE_PARALLELISM=4   # Max parallel languages per story (2–8). Higher = faster per story, more API load.
# TRANSLATION_LANGUAGE_TIMEOUT_MINUTES=5   # Per-language timeout. If exceeded, that language fails and others continue.
# TRANSLATION_PIPELINE_TOTAL_TIMEOUT_MINUTES=60   # Total timeout for all languages (parallel). Increase to 90 if you see "Cancelled after total timeout".
# PIPELINE_ON_SUBMIT_ONLY=true   # When true (default): pipeline runs only when "Submit for review" is used. When false, publish/update also triggers (legacy). If pipeline fails, use Run pipeline from Story library.
# AUDIO_AFTER_APPROVAL=true   # Default. When true: Submit for review only queues the story (no translate/TTS on submit). Run Generate translations from story edit (open from Story library) before review. When false: legacy — full pipeline may run on Submit for review.
# AUTO_TTS_ON_APPROVE=false   # Default. When false: Approve does not start TTS — use Narration (Story to Speech) → Generate audio. When true: Approve also kicks off background TTS if audio is still missing.
# KEEP_NARRATION_APPROVAL_ON_METADATA_ONLY_PUBLISHED_UPDATE=false   # When true, metadata-only edits on published stories keep approval; text changes still clear approval.
# TRANSLATION_MASTER_ONLY_NARRATION=false   # When true: curated TTS runs only for each story's master language; all locales reuse that audio. Skips bulk translation seed of target languages; parent library + category + listing queries use master narration readiness; pipeline triage ignores stale non-master translation rows; republish/regenerate fall back to master langs if UI sends only non-master codes.
# NARRATION_MAX_CONCURRENT_REWRITE=5   # Must be >= TRANSLATION_PIPELINE_PARALLELISM or tasks timeout. Lower if OpenAI 429.

# --- Admin update latency observability (Prometheus) ---
# application.yml enables histogram + SLO buckets for admin_story_update_latency.
# Query examples:
# histogram_quantile(0.95, sum(rate(admin_story_update_latency_seconds_bucket[5m])) by (le,scope,status))
# histogram_quantile(0.99, sum(rate(admin_story_update_latency_seconds_bucket[5m])) by (le,scope,status))

# --- DORA metrics reporting automation (optional) ---
# Used by scripts/report-dora-event.sh in CI/CD or release pipelines.
# DORA_API_BASE_URL=http://localhost:8080
# DORA_ADMIN_BEARER_TOKEN=   # Admin JWT used to call /api/v1/admin/metrics/dora/*

# --- AI control plane (governance spine for story generation) ---
# When true (default in application.yml), each generate flow opens a workflow run and completes/fails it in ai_workflow_runs. Requires DB migrations V75+V76.
# TAMIXA_CONTROL_PLANE_STORY_WORKFLOW=false
# TAMIXA_CONTROL_PLANE_STORY_PROJECT_CODE=tamixa
# TAMIXA_CONTROL_PLANE_STORY_WORKFLOW_KEY=story.create_with_narration

# --- Debug (optional) ---
# DEBUG_LOG_PATH=/path/to/debug.log   # If set, writes debug payloads (SSML, library JSON) for troubleshooting. Unset = no-op.
