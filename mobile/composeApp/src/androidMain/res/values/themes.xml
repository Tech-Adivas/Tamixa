<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tamixa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">#6750A4</item>
        <item name="android:colorPrimaryDark">#381E72</item>
    </style>

    <!-- Splash: dark background, no launcher icon. Shows until first frame. -->
    <style name="Theme.Tamixa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0D0D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Tamixa</item>
        <item name="android:windowBackground">#0D0D0D</item>
    </style>
</resources>
