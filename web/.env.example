# Backend API origin (no trailing slash). Used for client-side API calls and Vite dev proxy target.
# Local: leave unset (defaults to http://localhost:8080) or:
# VITE_API_BASE_URL=http://localhost:8080
# Team dev API (web host is https://dev.web.tamixa.in):
# VITE_API_BASE_URL=https://dev.tamixa.in
# Production Docker/Railway build arg / env:
# VITE_API_BASE_URL=https://tamixa-prod.up.railway.app

# Optional: pipe-separated lines for Settings → Support & safety (plain text; URLs auto-linked).
# Example (verify with legal before production):
# VITE_COMPLIANCE_RESOURCE_LINES=National Cyber Crime Reporting|https://www.cybercrime.gov.in
